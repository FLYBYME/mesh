{
  "name": "@flybyme/mesh",
  "version": "1.0.0",
  "description": "Mesh network framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "bin": {
    "mesh": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FLYBYME/mesh.git"
  },
  "dependencies": {
    "commander": "latest",
    "esbuild": "latest",
    "eventemitter3": "latest",
    "express": "latest",
    "mongodb": "latest",
    "nanoid": "latest",
    "ws": "latest",
    "zod": "latest",
    "zod-to-json-schema": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/jest": "latest",
    "@types/node": "latest",
    "@types/ws": "latest",
    "jest": "latest",
    "ts-jest": "latest",
    "typescript": "latest"
  }
}
